{"intro": 1.5, "total": 644.5, "voz": "DarkPlanner (tratada)", "frases": [{"i": 1, "texto": "Em 13 de março de 1962, o general mais graduado dos Estados Unidos assinou um plano para explodir um navio americano e culpar Cuba.", "cap": "ABERTURA", "ini": 1.5, "fim": 10.98, "pausa": 0.0, "t": [1.5, 1.64, 1.96, 2.18, 2.6, 2.76, 4.78, 4.88, 5.14, 5.56, 6.18, 6.38, 6.7, 7.2, 7.76, 7.94, 8.22, 8.48, 8.96, 9.12, 9.38, 10.0, 10.28, 10.56]}, {"i": 2, "texto": "Isso não é teoria da conspiração.", "cap": "ABERTURA", "ini": 11.64, "fim": 13.56, "pausa": 0.0, "t": [11.64, 11.86, 12.18, 12.38, 12.7, 12.88]}, {"i": 3, "texto": "Está escrito, assinado e guardado no Arquivo Nacional americano.", "cap": "ABERTURA", "ini": 13.94, "fim": 17.96, "pausa": 0.0, "t": [13.94, 14.18, 15.02, 15.62, 15.88, 16.44, 16.6, 16.96, 17.16]}, {"i": 4, "texto": "O plano nunca foi executado.", "cap": "ABERTURA", "ini": 18.58, "fim": 20.36, "pausa": 0.5, "t": [18.58, 18.72, 19.0, 19.44, 19.72]}, {"i": 5, "texto": "Mas ele existiu.", "cap": "ABERTURA", "ini": 21.26, "fim": 22.08, "pausa": 0.0, "t": [21.26, 21.44, 21.58]}, {"i": 6, "texto": "E ficou em segredo por trinta e cinco anos.", "cap": "ABERTURA", "ini": 22.08, "fim": 24.8, "pausa": 0.0, "t": [22.08, 22.64, 22.86, 23.02, 23.44, 23.77, 23.935, 24.017, 24.1]}, {"i": 7, "texto": "Então, onde termina a conspiração verdadeira e onde começa a invenção?", "cap": "ABERTURA", "ini": 25.48, "fim": 30.02, "pausa": 0.0, "t": [25.48, 26.36, 26.54, 27.06, 27.18, 27.74, 28.46, 28.76, 28.92, 29.4, 29.58]}, {"i": 8, "texto": "Para responder, imagine um iceberg.", "cap": "ABERTURA", "ini": 30.02, "fim": 32.7, "pausa": 5.24, "t": [30.02, 30.84, 31.84, 32.18, 32.36], "titulo_ini": 33.7}, {"i": 9, "texto": "Na internet, as teorias da conspiração costumam ser organizadas assim.", "cap": "O ICEBERG", "ini": 38.7, "fim": 42.6, "pausa": 0.0, "t": [38.7, 38.94, 39.8, 39.88, 40.22, 40.36, 40.98, 41.38, 41.62, 42.22]}, {"i": 10, "texto": "No topo, o que todo mundo já ouviu.", "cap": "O ICEBERG", "ini": 43.18, "fim": 45.46, "pausa": 0.0, "t": [43.18, 43.32, 44.02, 44.1, 44.2, 44.5, 44.86, 45.06]}, {"i": 11, "texto": "Lá embaixo, no escuro, o que só os mais obcecados conhecem.", "cap": "O ICEBERG", "ini": 45.92, "fim": 49.94, "pausa": 0.0, "t": [45.92, 46.1, 46.82, 46.88, 47.8, 47.86, 47.96, 48.28, 48.44, 48.66, 49.34]}, {"i": 12, "texto": "Aqui, a regra vai ser outra.", "cap": "O ICEBERG", "ini": 50.46, "fim": 52.14, "pausa": 0.0, "t": [50.46, 51.2, 51.28, 51.54, 51.68, 51.86]}, {"i": 13, "texto": "Cada nível vai ser medido por uma coisa só:", "cap": "O ICEBERG", "ini": 52.62, "fim": 54.98, "pausa": 0.0, "t": [52.62, 52.86, 53.24, 53.46, 53.62, 53.96, 54.2, 54.36, 54.66]}, {"i": 14, "texto": "o que está nos documentos.", "cap": "O ICEBERG", "ini": 55.48, "fim": 56.84, "pausa": 0.0, "t": [55.48, 55.64, 55.72, 56.04, 56.22]}, {"i": 15, "texto": "No topo, conspirações que os próprios governos confessaram.", "cap": "O ICEBERG", "ini": 57.4, "fim": 60.8, "pausa": 0.0, "t": [57.4, 57.6, 58.34, 58.94, 59.1, 59.22, 59.64, 60.18]}, {"i": 16, "texto": "Quanto mais fundo, menos papel.", "cap": "O ICEBERG", "ini": 61.28, "fim": 63.18, "pausa": 0.0, "t": [61.28, 61.5, 61.74, 62.58, 62.8]}, {"i": 17, "texto": "Até chegar a um ponto onde não existe papel nenhum.", "cap": "O ICEBERG", "ini": 63.72, "fim": 66.34, "pausa": 0.0, "t": [63.72, 63.96, 64.24, 64.36, 64.46, 64.82, 65.04, 65.2, 65.54, 65.96]}, {"i": 18, "texto": "E há uma surpresa nessa descida.", "cap": "O ICEBERG", "ini": 66.96, "fim": 68.7, "pausa": 0.0, "t": [66.96, 67.2, 67.28, 67.42, 67.96, 68.2]}, {"i": 19, "texto": "A parte mais assustadora do iceberg não está no fundo.", "cap": "O ICEBERG", "ini": 69.16, "fim": 72.36, "pausa": 0.36, "t": [69.16, 69.28, 69.54, 69.94, 70.56, 70.74, 71.14, 71.6, 71.92, 72.06]}, {"i": 20, "texto": "Está no topo.", "cap": "O ICEBERG", "ini": 73.26, "fim": 74.18, "pausa": 1.38, "t": [73.26, 73.54, 73.68]}, {"i": 21, "texto": "O primeiro nível é o das conspirações que o próprio governo admitiu.", "cap": "NÍVEL 1: CONFESSADO", "ini": 76.08, "fim": 79.68, "pausa": 0.0, "t": [76.08, 76.2, 76.46, 76.86, 77.16, 77.22, 77.32, 77.98, 78.18, 78.28, 78.62, 79.08]}, {"i": 22, "texto": "A primeira você já conhece.", "cap": "NÍVEL 1: CONFESSADO", "ini": 80.16, "fim": 81.56, "pausa": 0.0, "t": [80.16, 80.28, 80.62, 80.86, 81.06]}, {"i": 23, "texto": "O memorando de 1962 se chama Operação Northwoods.", "cap": "NÍVEL 1: CONFESSADO", "ini": 81.92, "fim": 86.68, "pausa": 0.0, "t": [81.92, 82.02, 82.48, 82.66, 83.76, 84.54, 84.82, 85.48]}, {"i": 24, "texto": "Ele listava pretextos para justificar uma invasão de Cuba.", "cap": "NÍVEL 1: CONFESSADO", "ini": 86.7, "fim": 90.0, "pausa": 0.0, "t": [86.7, 86.96, 87.53, 88.1, 88.32, 88.94, 89.16, 89.56, 89.68]}, {"i": 25, "texto": "Afundar um barco com refugiados.", "cap": "NÍVEL 1: CONFESSADO", "ini": 90.58, "fim": 92.28, "pausa": 0.34, "t": [90.58, 90.98, 91.1, 91.48, 91.64]}, {"i": 26, "texto": "Explodir bombas em Miami.", "cap": "NÍVEL 1: CONFESSADO", "ini": 93.18, "fim": 94.58, "pausa": 0.5, "t": [93.18, 93.62, 94.06, 94.18]}, {"i": 27, "texto": "Simular que um avião cheio de estudantes tinha sido derrubado.", "cap": "NÍVEL 1: CONFESSADO", "ini": 95.48, "fim": 98.78, "pausa": 0.0, "t": [95.48, 96.0, 96.22, 96.32, 96.58, 97.06, 97.16, 97.64, 97.96, 98.2]}, {"i": 28, "texto": "O plano falava até em funerais falsos para vítimas inventadas e numa campanha de terror em Miami e até em Washington.", "cap": "NÍVEL 1: CONFESSADO", "ini": 99.26, "fim": 106.3, "pausa": 0.0, "t": [99.26, 99.36, 99.64, 100.1, 100.36, 100.46, 101.26, 101.58, 101.82, 102.22, 103.0, 103.38, 103.52, 103.96, 104.1, 104.42, 104.64, 105.08, 105.44, 105.7, 105.84]}, {"i": 29, "texto": "O general que assinou, Lyman Lemnitzer, não foi reconduzido ao comando no fim do mandato.", "cap": "NÍVEL 1: CONFESSADO", "ini": 106.84, "fim": 111.86, "pausa": 0.0, "t": [106.84, 106.96, 107.24, 107.44, 108.22, 108.52, 109.4, 109.64, 109.9, 110.52, 110.64, 111.0, 111.16, 111.34, 111.44]}, {"i": 30, "texto": "O documento foi liberado em 1997, no meio de mais de mil e quinhentas páginas de registros militares.", "cap": "NÍVEL 1: CONFESSADO", "ini": 112.31, "fim": 119.28, "pausa": 0.0, "t": [112.31, 112.7, 113.08, 113.47, 113.86, 114.25, 114.63, 115.02, 115.41, 115.8, 116.18, 116.57, 116.96, 117.34, 117.73, 118.12, 118.51, 118.89]}, {"i": 31, "texto": "A segunda aconteceu no Alabama, na cidade de Tuskegee.", "cap": "NÍVEL 1: CONFESSADO", "ini": 119.74, "fim": 123.0, "pausa": 0.0, "t": [119.74, 119.82, 120.18, 120.7, 120.92, 121.74, 121.82, 122.12, 122.34]}, {"i": 32, "texto": "Durante quarenta anos, médicos do serviço de saúde pública americano acompanharam homens negros com sífilis sem tratar a doença.", "cap": "NÍVEL 1: CONFESSADO", "ini": 123.52, "fim": 131.24, "pausa": 0.0, "t": [123.52, 123.85, 124.18, 125.08, 125.48, 125.64, 126.1, 126.24, 126.54, 126.92, 127.62, 128.4, 128.64, 129.08, 129.26, 129.94, 130.26, 130.64, 130.8]}, {"i": 33, "texto": "Em 1997, o presidente Bill Clinton pediu desculpas em nome do governo.", "cap": "NÍVEL 1: CONFESSADO", "ini": 131.68, "fim": 136.64, "pausa": 0.0, "t": [131.68, 131.8, 133.52, 133.6, 133.9, 134.32, 134.76, 135.12, 135.74, 135.94, 136.08, 136.22]}, {"i": 34, "texto": "Disse que, mesmo depois que a cura foi descoberta, aqueles homens tiveram ajuda negada e foram enganados pelo próprio governo.", "cap": "NÍVEL 1: CONFESSADO", "ini": 137.46, "fim": 144.56, "pausa": 0.0, "t": [137.46, 137.46, 138.02, 138.22, 138.7, 138.84, 138.92, 139.18, 139.32, 140.32, 140.5, 140.92, 141.32, 141.58, 142.2, 142.56, 142.74, 143.34, 143.62, 144.02]}, {"i": 35, "texto": "A terceira começou em 1953, dentro da CIA.", "cap": "NÍVEL 1: CONFESSADO", "ini": 144.56, "fim": 148.98, "pausa": 0.0, "t": [144.56, 145.18, 145.68, 145.96, 146.34, 147.48, 148.44, 148.68]}, {"i": 36, "texto": "Chamava-se MKUltra.", "cap": "NÍVEL 1: CONFESSADO", "ini": 149.03, "fim": 151.51, "pausa": 0.0, "t": [150.27, 150.89]}, {"i": 37, "texto": "A agência financiou pesquisas sobre controle do comportamento em cerca de oitenta instituições.", "cap": "NÍVEL 1: CONFESSADO", "ini": 151.56, "fim": 156.76, "pausa": 0.42, "t": [151.56, 151.66, 152.04, 152.62, 153.2, 153.46, 153.96, 154.12, 154.9, 155.18, 155.42, 155.73, 156.04]}, {"i": 38, "texto": "Universidades, hospitais e prisões.", "cap": "NÍVEL 1: CONFESSADO", "ini": 157.66, "fim": 160.04, "pausa": 0.36, "t": [157.66, 158.76, 159.3, 159.6]}, {"i": 39, "texto": "E deu LSD a pessoas que não sabiam de nada.", "cap": "NÍVEL 1: CONFESSADO", "ini": 160.94, "fim": 163.96, "pausa": 0.0, "t": [160.94, 161.02, 161.16, 161.94, 162.24, 162.58, 162.84, 163.0, 163.42, 163.6]}, {"i": 40, "texto": "Uma delas foi um cientista do Exército, Frank Olson.", "cap": "NÍVEL 1: CONFESSADO", "ini": 164.44, "fim": 167.64, "pausa": 0.0, "t": [164.44, 164.64, 165.12, 165.26, 165.4, 165.92, 166.06, 166.86, 167.12]}, {"i": 41, "texto": "Ele recebeu a droga sem saber, em novembro de 1953, e morreu nove dias depois, ao cair da janela de um hotel.", "cap": "NÍVEL 1: CONFESSADO", "ini": 167.88, "fim": 176.1, "pausa": 0.0, "t": [167.88, 168.06, 168.52, 168.58, 168.9, 169.18, 169.62, 170.02, 170.48, 170.62, 171.88, 172.86, 173.21, 173.56, 173.88, 174.7, 174.88, 175.08, 175.24, 175.62, 175.76, 175.86]}, {"i": 42, "texto": "Em 1975, o presidente Gerald Ford recebeu a família e pediu desculpas em nome do governo.", "cap": "NÍVEL 1: CONFESSADO", "ini": 176.62, "fim": 183.42, "pausa": 0.0, "t": [176.62, 176.84, 178.68, 178.88, 179.26, 179.76, 180.22, 180.88, 180.98, 181.36, 181.68, 181.9, 182.54, 182.74, 182.92, 183.06]}, {"i": 43, "texto": "Em 1973, o diretor da CIA mandou destruir os arquivos.", "cap": "NÍVEL 1: CONFESSADO", "ini": 183.94, "fim": 188.8, "pausa": 0.0, "t": [183.94, 184.14, 186.1, 186.16, 186.58, 186.74, 187.08, 187.5, 188.22, 188.32]}, {"i": 44, "texto": "Mas cerca de oito mil páginas de papéis financeiros estavam em outro depósito.", "cap": "NÍVEL 1: CONFESSADO", "ini": 189.26, "fim": 194.0, "pausa": 0.0, "t": [189.26, 189.44, 189.78, 190.06, 190.34, 190.6, 191.24, 191.36, 191.68, 192.3, 192.84, 193.08, 193.36]}, {"i": 45, "texto": "Em 1977, o Senado americano ouviu a história inteira.", "cap": "NÍVEL 1: CONFESSADO", "ini": 194.4, "fim": 199.26, "pausa": 0.44, "t": [194.4, 194.56, 196.56, 196.62, 196.98, 197.62, 198.08, 198.14, 198.52]}, {"i": 46, "texto": "Três casos.", "cap": "NÍVEL 1: CONFESSADO", "ini": 200.16, "fim": 200.96, "pausa": 0.34, "t": [200.16, 200.52]}, {"i": 47, "texto": "Três confissões.", "cap": "NÍVEL 1: CONFESSADO", "ini": 201.86, "fim": 202.76, "pausa": 0.28, "t": [201.86, 202.12]}, {"i": 48, "texto": "Nenhum deles precisa de teoria.", "cap": "NÍVEL 1: CONFESSADO", "ini": 203.66, "fim": 205.48, "pausa": 0.26, "t": [203.66, 204.04, 204.4, 204.9, 205.12]}, {"i": 49, "texto": "Todos têm papel.", "cap": "NÍVEL 1: CONFESSADO", "ini": 206.38, "fim": 207.3, "pausa": 1.34, "t": [206.38, 206.66, 206.98]}, {"i": 50, "texto": "Descendo um pouco, chegamos às conspirações que ninguém confessou de boa vontade.", "cap": "NÍVEL 2: PROVADO NOS PAPÉIS", "ini": 209.2, "fim": 213.5, "pausa": 0.32, "t": [209.2, 209.6, 209.76, 210.32, 210.66, 210.84, 211.5, 211.76, 212.1, 212.8, 212.94, 213.12]}, {"i": 51, "texto": "Elas foram arrancadas.", "cap": "NÍVEL 2: PROVADO NOS PAPÉIS", "ini": 214.4, "fim": 215.82, "pausa": 0.24, "t": [214.4, 214.66, 214.9]}, {"i": 52, "texto": "Na noite de 8 de março de 1971, um grupo de pessoas invadiu um escritório do FBI numa cidade pequena da Pensilvânia, chamada Media.", "cap": "NÍVEL 2: PROVADO NOS PAPÉIS", "ini": 216.72, "fim": 225.64, "pausa": 0.0, "t": [216.72, 216.86, 217.1, 217.34, 217.52, 217.76, 218.12, 218.28, 220.0, 220.24, 220.48, 220.64, 221.02, 221.66, 221.74, 222.26, 222.42, 222.8, 223.28, 223.64, 224.22, 224.34, 225.34, 225.49]}, {"i": 53, "texto": "Levaram documentos e mandaram cópias para jornais.", "cap": "NÍVEL 2: PROVADO NOS PAPÉIS", "ini": 226.18, "fim": 229.44, "pausa": 0.0, "t": [226.18, 226.92, 227.68, 227.82, 228.14, 228.62, 228.82]}, {"i": 54, "texto": "Os papéis revelaram um programa secreto chamado COINTELPRO.", "cap": "NÍVEL 2: PROVADO NOS PAPÉIS", "ini": 229.72, "fim": 232.4, "pausa": 0.0, "t": [229.72, 229.92, 230.32, 230.86, 231.0, 231.28, 232.02, 232.21]}, {"i": 55, "texto": "Entre 1956 e 1971, o FBI usou cartas anônimas, informantes e campanhas de difamação contra grupos políticos americanos.", "cap": "NÍVEL 2: PROVADO NOS PAPÉIS", "ini": 233.86, "fim": 244.68, "pausa": 0.0, "t": [233.86, 234.06, 235.2, 236.0, 237.8, 237.96, 238.2, 238.82, 239.28, 240.18, 240.86, 241.34, 241.9, 242.02, 242.72, 243.02, 243.36, 243.94]}, {"i": 56, "texto": "Um dos alvos foi Martin Luther King.", "cap": "NÍVEL 2: PROVADO NOS PAPÉIS", "ini": 244.98, "fim": 247.16, "pausa": 0.0, "t": [244.98, 245.18, 245.28, 245.68, 246.0, 246.5, 246.76]}, {"i": 57, "texto": "Segundo a investigação do Senado, o FBI mandou para King uma gravação feita com microfones escondidos.", "cap": "NÍVEL 2: PROVADO NOS PAPÉIS", "ini": 247.58, "fim": 253.74, "pausa": 0.0, "t": [247.58, 247.94, 248.06, 248.58, 248.74, 249.5, 249.64, 249.94, 250.48, 250.66, 251.0, 251.3, 251.84, 252.22, 252.36, 252.9]}, {"i": 58, "texto": "Junto, ia um bilhete que King e seus assessores entenderam como uma ameaça:", "cap": "NÍVEL 2: PROVADO NOS PAPÉIS", "ini": 254.12, "fim": 258.84, "pausa": 0.0, "t": [254.12, 254.82, 254.94, 255.06, 255.56, 255.88, 256.26, 256.48, 256.83, 257.18, 257.86, 258.06, 258.26]}, {"i": 59, "texto": "divulgar a gravação, a menos que ele se matasse.", "cap": "NÍVEL 2: PROVADO NOS PAPÉIS", "ini": 259.26, "fim": 262.18, "pausa": 0.0, "t": [259.26, 259.78, 259.9, 260.5, 260.9, 261.2, 261.44, 261.56, 261.72]}, {"i": 60, "texto": "Uma comissão do Senado concluiu em 1976 que houve mais de duas mil ações aprovadas.", "cap": "NÍVEL 2: PROVADO NOS PAPÉIS", "ini": 262.56, "fim": 269.2, "pausa": 0.0, "t": [262.56, 262.74, 263.18, 263.28, 263.76, 264.32, 264.54, 266.5, 266.68, 266.9, 267.18, 267.47, 267.76, 268.12, 268.52]}, {"i": 61, "texto": "O segundo caso deste nível é o Golfo de Tonkin, em 1964.", "cap": "NÍVEL 2: PROVADO NOS PAPÉIS", "ini": 269.72, "fim": 274.1, "pausa": 0.0, "t": [269.72, 269.84, 270.1, 270.4, 270.74, 271.18, 271.42, 271.54, 271.98, 272.04, 272.82, 272.92]}, {"i": 62, "texto": "Dois navios americanos atiraram a noite inteira contra um inimigo no escuro.", "cap": "NÍVEL 2: PROVADO NOS PAPÉIS", "ini": 274.96, "fim": 279.44, "pausa": 0.0, "t": [274.96, 275.22, 275.5, 276.26, 276.82, 276.96, 277.3, 278.02, 278.38, 278.5, 278.92, 279.02]}, {"i": 63, "texto": "O ataque serviu de motivo para a Guerra do Vietnã.", "cap": "NÍVEL 2: PROVADO NOS PAPÉIS", "ini": 279.44, "fim": 282.42, "pausa": 0.0, "t": [279.44, 279.92, 280.24, 280.74, 280.86, 281.28, 281.54, 281.68, 281.84, 281.98]}, {"i": 64, "texto": "Em 2005, um estudo da própria agência de espionagem eletrônica dos Estados Unidos veio a público.", "cap": "NÍVEL 2: PROVADO NOS PAPÉIS", "ini": 282.8, "fim": 288.48, "pausa": 0.4, "t": [282.8, 282.94, 283.94, 284.02, 284.4, 284.56, 284.96, 285.42, 285.6, 286.1, 286.7, 286.86, 287.16, 287.62, 288.0, 288.16]}, {"i": 65, "texto": "A conclusão:", "cap": "NÍVEL 2: PROVADO NOS PAPÉIS", "ini": 289.38, "fim": 289.94, "pausa": 0.36, "t": [289.38, 289.46]}, {"i": 66, "texto": "naquela noite, não houve ataque nenhum.", "cap": "NÍVEL 2: PROVADO NOS PAPÉIS", "ini": 290.84, "fim": 293.22, "pausa": 0.0, "t": [290.84, 291.12, 291.9, 292.0, 292.32, 292.7]}, {"i": 67, "texto": "E o próprio comandante dos navios tinha avisado, no mesmo dia, que muitos contatos e torpedos pareciam duvidosos.", "cap": "NÍVEL 2: PROVADO NOS PAPÉIS", "ini": 293.64, "fim": 300.72, "pausa": 0.0, "t": [293.64, 293.76, 293.86, 294.2, 294.8, 295.0, 295.42, 295.68, 296.46, 296.52, 296.84, 297.64, 297.74, 298.06, 298.76, 298.9, 299.42, 300.04]}, {"i": 68, "texto": "E o terceiro é a Operação Paperclip.", "cap": "NÍVEL 2: PROVADO NOS PAPÉIS", "ini": 301.22, "fim": 303.58, "pausa": 0.0, "t": [301.22, 301.38, 301.42, 302.0, 302.22, 302.26, 302.78]}, {"i": 69, "texto": "Depois da Segunda Guerra, os Estados Unidos levaram mais de mil e quinhentos cientistas e técnicos alemães.", "cap": "NÍVEL 2: PROVADO NOS PAPÉIS", "ini": 304.02, "fim": 309.92, "pausa": 0.62, "t": [304.02, 304.28, 304.46, 304.76, 305.42, 305.5, 305.8, 306.14, 306.68, 306.9, 307.3, 307.5, 307.6, 307.7, 308.66, 308.86, 309.4]}, {"i": 70, "texto": "Alguns tinham passado nazista.", "cap": "NÍVEL 2: PROVADO NOS PAPÉIS", "ini": 310.82, "fim": 312.78, "pausa": 0.56, "t": [310.82, 311.48, 311.66, 311.98]}, {"i": 71, "texto": "Um deles, Arthur Rudolph, gerente de produção de uma fábrica de foguetes onde prisioneiros morreram aos milhares, ajudou a levar o homem à Lua.", "cap": "NÍVEL 2: PROVADO NOS PAPÉIS", "ini": 313.68, "fim": 322.26, "pausa": 0.0, "t": [313.68, 313.86, 314.5, 315.09, 315.68, 316.08, 316.22, 316.62, 316.84, 316.96, 317.4, 317.54, 318.14, 318.36, 318.98, 319.5, 319.64, 320.74, 321.16, 321.26, 321.5, 321.66, 321.84, 322.02]}, {"i": 72, "texto": "Em 1984, deixou o país.", "cap": "NÍVEL 2: PROVADO NOS PAPÉIS", "ini": 322.68, "fim": 325.28, "pausa": 0.0, "t": [322.68, 322.82, 324.48, 324.96, 325.1]}, {"i": 73, "texto": "Neste nível, a lição é outra.", "cap": "NÍVEL 2: PROVADO NOS PAPÉIS", "ini": 325.82, "fim": 327.58, "pausa": 0.0, "t": [325.82, 326.16, 326.84, 326.86, 327.14, 327.28]}, {"i": 74, "texto": "Quem revelou esses segredos não foram teóricos da conspiração.", "cap": "NÍVEL 2: PROVADO NOS PAPÉIS", "ini": 327.98, "fim": 331.58, "pausa": 0.0, "t": [327.98, 328.1, 328.56, 328.74, 329.34, 329.7, 330.1, 330.76, 330.88]}, {"i": 75, "texto": "Foram ladrões de documentos, historiadores, senadores e pedidos de acesso à informação.", "cap": "NÍVEL 2: PROVADO NOS PAPÉIS", "ini": 331.78, "fim": 337.14, "pausa": 0.48, "t": [331.78, 332.06, 332.42, 332.58, 333.58, 334.36, 335.14, 335.64, 336.12, 336.28, 336.64, 336.84]}, {"i": 76, "texto": "Agora a água fica mais escura.", "cap": "NÍVEL 3: O SEGREDO QUE VIROU LENDA", "ini": 339.04, "fim": 341.2, "pausa": 0.0, "t": [339.04, 339.72, 340.04, 340.26, 340.48, 340.74]}, {"i": 77, "texto": "Este é o nível mais interessante do iceberg.", "cap": "NÍVEL 3: O SEGREDO QUE VIROU LENDA", "ini": 341.64, "fim": 343.86, "pausa": 0.0, "t": [341.64, 342.02, 342.16, 342.2, 342.42, 342.8, 343.42, 343.66]}, {"i": 78, "texto": "Aqui, existe um segredo verdadeiro.", "cap": "NÍVEL 3: O SEGREDO QUE VIROU LENDA", "ini": 344.62, "fim": 347.16, "pausa": 0.0, "t": [344.62, 344.96, 345.62, 345.8, 346.34]}, {"i": 79, "texto": "Só que em cima dele cresceu uma lenda.", "cap": "NÍVEL 3: O SEGREDO QUE VIROU LENDA", "ini": 347.56, "fim": 349.8, "pausa": 0.3, "t": [347.56, 347.8, 347.94, 348.06, 348.36, 348.72, 349.22, 349.48]}, {"i": 80, "texto": "Comece pela Área 51.", "cap": "NÍVEL 3: O SEGREDO QUE VIROU LENDA", "ini": 350.7, "fim": 352.16, "pausa": 0.18, "t": [350.7, 351.12, 351.4, 351.64]}, {"i": 81, "texto": "Durante décadas, o governo americano não falava dela.", "cap": "NÍVEL 3: O SEGREDO QUE VIROU LENDA", "ini": 353.06, "fim": 356.08, "pausa": 0.0, "t": [353.06, 353.28, 353.96, 354.24, 354.46, 354.98, 355.32, 355.76]}, {"i": 82, "texto": "E a falta de resposta virou combustível para histórias sobre discos voadores e alienígenas.", "cap": "NÍVEL 3: O SEGREDO QUE VIROU LENDA", "ini": 356.08, "fim": 361.88, "pausa": 0.48, "t": [356.08, 356.68, 356.76, 357.08, 357.24, 357.9, 358.16, 358.92, 359.14, 359.58, 359.88, 360.32, 360.84, 361.14]}, {"i": 83, "texto": "O U-2 era real.", "cap": "NÍVEL 3: O SEGREDO QUE VIROU LENDA", "ini": 362.78, "fim": 364.52, "pausa": 0.34, "t": [362.78, 363.15, 363.52, 364.12]}, {"i": 84, "texto": "Em maio de 1960, um deles foi derrubado sobre a União Soviética, e o piloto, Francis Gary Powers, foi capturado.", "cap": "NÍVEL 3: O SEGREDO QUE VIROU LENDA", "ini": 365.42, "fim": 373.22, "pausa": 0.0, "t": [365.42, 365.56, 365.86, 366.0, 367.56, 367.76, 368.0, 368.22, 368.7, 368.98, 369.08, 369.28, 370.16, 370.36, 370.42, 370.86, 371.38, 371.76, 372.18, 372.62]}, {"i": 85, "texto": "O caso virou crise internacional.", "cap": "NÍVEL 3: O SEGREDO QUE VIROU LENDA", "ini": 373.76, "fim": 375.48, "pausa": 0.0, "t": [373.76, 373.86, 374.14, 374.52, 374.92]}, {"i": 86, "texto": "Em 2013, a CIA liberou a história oficial do avião espião U-2.", "cap": "NÍVEL 3: O SEGREDO QUE VIROU LENDA", "ini": 376.24, "fim": 380.02, "pausa": 0.0, "t": [376.24, 376.42, 377.36, 377.44, 377.72, 378.16, 378.24, 378.5, 379.14, 379.3, 379.54, 379.78]}, {"i": 87, "texto": "Ali, a base aparece como o lugar onde aviões secretos eram testados.", "cap": "NÍVEL 3: O SEGREDO QUE VIROU LENDA", "ini": 381.06, "fim": 384.92, "pausa": 0.0, "t": [381.06, 381.68, 381.76, 382.0, 382.4, 382.68, 382.76, 383.0, 383.22, 383.54, 384.16, 384.34]}, {"i": 88, "texto": "E tem mais.", "cap": "NÍVEL 3: O SEGREDO QUE VIROU LENDA", "ini": 384.92, "fim": 385.98, "pausa": 0.56, "t": [384.92, 385.56, 385.68]}, {"i": 89, "texto": "Em 1997, a revista interna da CIA publicou um estudo sobre a própria agência e os OVNIs.", "cap": "NÍVEL 3: O SEGREDO QUE VIROU LENDA", "ini": 386.88, "fim": 392.96, "pausa": 0.0, "t": [386.88, 387.1, 388.18, 389.0, 389.36, 389.86, 390.09, 390.32, 390.82, 390.94, 391.26, 391.56, 391.68, 392.0, 392.56, 392.8, 392.88]}, {"i": 90, "texto": "Segundo ele, mais da metade dos relatos de OVNI do fim dos anos 1950 e dos anos 1960 eram, na verdade, voos de aviões espiões americanos.", "cap": "NÍVEL 3: O SEGREDO QUE VIROU LENDA", "ini": 393.66, "fim": 404.02, "pausa": 0.0, "t": [393.66, 394.06, 394.7, 394.84, 395.02, 395.5, 395.7, 396.16, 396.4, 396.64, 396.82, 397.02, 397.2, 397.38, 398.44, 399.02, 399.16, 399.34, 400.9, 401.22, 401.36, 401.7, 402.32, 402.44, 402.98, 403.24]}, {"i": 91, "texto": "Ou seja, havia um segredo.", "cap": "NÍVEL 3: O SEGREDO QUE VIROU LENDA", "ini": 404.38, "fim": 406.4, "pausa": 0.0, "t": [404.38, 404.5, 405.28, 405.62, 405.8]}, {"i": 92, "texto": "Só não era o que as pessoas imaginavam.", "cap": "NÍVEL 3: O SEGREDO QUE VIROU LENDA", "ini": 406.76, "fim": 408.48, "pausa": 0.0, "t": [406.76, 406.92, 407.04, 407.28, 407.36, 407.42, 407.56, 407.8]}, {"i": 93, "texto": "Com Roswell, em 1947, foi parecido.", "cap": "NÍVEL 3: O SEGREDO QUE VIROU LENDA", "ini": 408.48, "fim": 412.06, "pausa": 0.0, "t": [408.48, 408.98, 409.56, 409.76, 410.7, 411.5]}, {"i": 94, "texto": "Algo caiu no deserto do Novo México, e o Exército falou primeiro em disco voador, depois em balão meteorológico.", "cap": "NÍVEL 3: O SEGREDO QUE VIROU LENDA", "ini": 412.5, "fim": 419.4, "pausa": 0.0, "t": [412.5, 412.8, 413.26, 413.32, 413.88, 413.96, 414.18, 414.6, 415.0, 415.08, 415.56, 415.8, 416.14, 416.38, 416.62, 417.52, 417.88, 418.2, 418.54]}, {"i": 95, "texto": "Em 1994, a Força Aérea publicou um relatório.", "cap": "NÍVEL 3: O SEGREDO QUE VIROU LENDA", "ini": 419.64, "fim": 423.32, "pausa": 0.0, "t": [419.64, 419.84, 420.9, 421.66, 421.96, 422.26, 422.7, 422.78]}, {"i": 96, "texto": "Os destroços eram de um projeto ultrassecreto chamado Mogul, que usava balões para tentar detectar testes nucleares soviéticos.", "cap": "NÍVEL 3: O SEGREDO QUE VIROU LENDA", "ini": 423.68, "fim": 431.16, "pausa": 0.42, "t": [423.68, 423.78, 424.4, 424.62, 424.78, 424.84, 425.56, 426.28, 426.54, 427.56, 427.64, 427.9, 428.32, 428.58, 428.9, 429.48, 429.98, 430.46]}, {"i": 97, "texto": "Era um balão.", "cap": "NÍVEL 3: O SEGREDO QUE VIROU LENDA", "ini": 432.06, "fim": 432.66, "pausa": 0.46, "t": [432.06, 432.22, 432.34]}, {"i": 98, "texto": "Mas um balão secreto.", "cap": "NÍVEL 3: O SEGREDO QUE VIROU LENDA", "ini": 433.56, "fim": 434.78, "pausa": 0.56, "t": [433.56, 433.74, 433.86, 434.14]}, {"i": 99, "texto": "O governo escondeu a verdade, e a lenda cresceu no lugar dela.", "cap": "NÍVEL 3: O SEGREDO QUE VIROU LENDA", "ini": 435.68, "fim": 439.56, "pausa": 0.0, "t": [435.68, 435.78, 436.1, 436.8, 436.88, 437.2, 437.82, 437.92, 438.24, 438.86, 439.0, 439.24]}, {"i": 100, "texto": "E o último caso deste nível parece ficção científica.", "cap": "NÍVEL 3: O SEGREDO QUE VIROU LENDA", "ini": 439.9, "fim": 443.22, "pausa": 0.0, "t": [439.9, 440.06, 440.16, 440.4, 440.76, 441.06, 441.48, 441.82, 442.42]}, {"i": 101, "texto": "Durante anos, o governo americano pagou pessoas para tentar ver lugares distantes só com a mente.", "cap": "NÍVEL 3: O SEGREDO QUE VIROU LENDA", "ini": 443.62, "fim": 449.3, "pausa": 0.0, "t": [443.62, 443.88, 444.64, 444.68, 444.86, 445.42, 445.82, 446.36, 446.58, 446.88, 447.12, 447.54, 448.2, 448.7, 448.88, 449.0]}, {"i": 102, "texto": "O programa ficou conhecido como Stargate.", "cap": "NÍVEL 3: O SEGREDO QUE VIROU LENDA", "ini": 449.68, "fim": 451.9, "pausa": 0.36, "t": [449.68, 449.76, 450.14, 450.46, 451.0, 451.26]}, {"i": 103, "texto": "Ele existiu.", "cap": "NÍVEL 3: O SEGREDO QUE VIROU LENDA", "ini": 452.8, "fim": 453.46, "pausa": 0.48, "t": [452.8, 452.98]}, {"i": 104, "texto": "Entre os papéis liberados pela CIA há sessões dessas pessoas tentando ver, à distância, onde estavam os reféns americanos no Irã, no fim dos anos 1970.", "cap": "NÍVEL 3: O SEGREDO QUE VIROU LENDA", "ini": 454.36, "fim": 463.8, "pausa": 0.0, "t": [454.36, 454.56, 454.7, 455.02, 455.48, 455.76, 456.13, 456.5, 456.9, 457.12, 457.66, 458.2, 458.52, 458.8, 459.42, 459.94, 460.36, 460.56, 460.92, 461.5, 461.66, 461.94, 462.22, 462.46, 462.62, 462.82]}, {"i": 105, "texto": "Em 1995, uma avaliação encomendada pela CIA concluiu que a informação nunca tinha sido usada para guiar nenhuma operação de inteligência.", "cap": "NÍVEL 3: O SEGREDO QUE VIROU LENDA", "ini": 463.8, "fim": 473.24, "pausa": 0.0, "t": [463.8, 464.64, 466.38, 466.54, 467.1, 467.64, 467.92, 468.3, 468.86, 469.0, 469.06, 469.44, 470.04, 470.36, 470.62, 471.0, 471.22, 471.48, 471.92, 472.48, 472.62]}, {"i": 106, "texto": "E que não valia a pena continuar.", "cap": "NÍVEL 3: O SEGREDO QUE VIROU LENDA", "ini": 473.24, "fim": 474.88, "pausa": 0.46, "t": [473.24, 473.62, 473.72, 473.84, 474.14, 474.26, 474.4]}, {"i": 107, "texto": "O programa era real.", "cap": "NÍVEL 3: O SEGREDO QUE VIROU LENDA", "ini": 475.78, "fim": 476.98, "pausa": 0.34, "t": [475.78, 475.86, 476.24, 476.64]}, {"i": 108, "texto": "O poder, não.", "cap": "NÍVEL 3: O SEGREDO QUE VIROU LENDA", "ini": 477.88, "fim": 478.88, "pausa": 1.3, "t": [477.88, 477.96, 478.66]}, {"i": 109, "texto": "Mais fundo, a luz quase não chega.", "cap": "NÍVEL 4: SEM PROVA", "ini": 480.78, "fim": 483.02, "pausa": 0.0, "t": [480.78, 481.06, 481.82, 481.86, 482.02, 482.48, 482.66]}, {"i": 110, "texto": "Aqui estão as teorias que têm milhões de seguidores, mas nenhum documento.", "cap": "NÍVEL 4: SEM PROVA", "ini": 483.48, "fim": 487.66, "pausa": 0.0, "t": [483.48, 483.76, 484.04, 484.18, 484.6, 484.76, 484.96, 485.36, 485.64, 486.5, 486.66, 486.96]}, {"i": 111, "texto": "A mais famosa diz que o homem nunca foi à Lua.", "cap": "NÍVEL 4: SEM PROVA", "ini": 487.9, "fim": 490.46, "pausa": 0.0, "t": [487.9, 488.0, 488.18, 488.7, 488.94, 489.1, 489.22, 489.42, 489.76, 490.1, 490.24]}, {"i": 112, "texto": "Que tudo foi filmado num estúdio.", "cap": "NÍVEL 4: SEM PROVA", "ini": 490.78, "fim": 492.54, "pausa": 0.0, "t": [490.78, 490.88, 491.22, 491.46, 491.9, 492.04]}, {"i": 113, "texto": "Só que a sonda americana que orbita a Lua desde 2009 fotografou os locais de pouso.", "cap": "NÍVEL 4: SEM PROVA", "ini": 492.54, "fim": 497.88, "pausa": 0.0, "t": [492.54, 492.96, 493.1, 493.16, 493.42, 493.98, 494.18, 494.56, 494.7, 494.88, 495.2, 495.88, 496.94, 497.06, 497.42, 497.52]}, {"i": 114, "texto": "Na imagem da Apollo 17, dá para ver a parte de baixo do módulo lunar que ficou lá, em 1972.", "cap": "NÍVEL 4: SEM PROVA", "ini": 498.2, "fim": 505.08, "pausa": 0.0, "t": [498.2, 498.32, 498.64, 498.84, 499.12, 499.7, 500.28, 500.48, 500.7, 500.8, 501.02, 501.24, 501.68, 501.9, 502.28, 502.66, 502.9, 503.18, 503.48, 503.88]}, {"i": 115, "texto": "Para que o pouso fosse falso, milhares de engenheiros, cientistas e astronautas teriam guardado o mesmo segredo por mais de meio século.", "cap": "NÍVEL 4: SEM PROVA", "ini": 506.04, "fim": 514.94, "pausa": 0.0, "t": [506.04, 506.32, 506.46, 506.56, 506.82, 507.1, 508.04, 508.54, 508.72, 509.74, 510.34, 510.5, 511.28, 511.78, 512.22, 512.48, 512.68, 513.34, 513.56, 513.84, 514.02, 514.36]}, {"i": 116, "texto": "Enquanto isso, segredos bem menores, como os que você viu nos níveis de cima, vazaram em poucos anos.", "cap": "NÍVEL 4: SEM PROVA", "ini": 515.46, "fim": 521.58, "pausa": 0.0, "t": [515.46, 515.82, 516.66, 517.06, 517.38, 518.1, 518.26, 518.4, 518.44, 518.68, 518.9, 519.04, 519.32, 519.48, 520.22, 520.46, 520.7, 521.28]}, {"i": 117, "texto": "Neste nível, a falta de papel não é sinal de que alguém escondeu bem.", "cap": "NÍVEL 4: SEM PROVA", "ini": 522.2, "fim": 526.3, "pausa": 0.0, "t": [522.2, 522.6, 523.34, 523.4, 523.68, 523.86, 524.24, 524.58, 524.84, 525.16, 525.34, 525.44, 525.78, 526.12]}, {"i": 118, "texto": "É sinal de que não há nada para esconder.", "cap": "NÍVEL 4: SEM PROVA", "ini": 526.86, "fim": 528.92, "pausa": 1.36, "t": [526.86, 527.04, 527.32, 527.5, 527.62, 527.76, 527.92, 528.32, 528.52]}, {"i": 119, "texto": "E então chegamos ao fundo do iceberg.", "cap": "NÍVEL 5: O FUNDO", "ini": 530.82, "fim": 533.12, "pausa": 0.0, "t": [530.82, 531.06, 531.42, 532.02, 532.22, 532.64, 532.84]}, {"i": 120, "texto": "Aqui ficam as ideias que contrariam o que qualquer pessoa pode verificar.", "cap": "NÍVEL 5: O FUNDO", "ini": 533.96, "fim": 538.26, "pausa": 0.0, "t": [533.96, 534.34, 534.74, 534.88, 535.26, 535.42, 536.2, 536.38, 536.46, 537.2, 537.48, 537.74]}, {"i": 121, "texto": "A mais conhecida é a de que a Terra é plana.", "cap": "NÍVEL 5: O FUNDO", "ini": 538.9, "fim": 541.38, "pausa": 0.0, "t": [538.9, 539.06, 539.22, 539.8, 540.12, 540.24, 540.28, 540.4, 540.48, 540.78, 540.92]}, {"i": 122, "texto": "Não existe um único documento, de nenhum governo, que sustente isso.", "cap": "NÍVEL 5: O FUNDO", "ini": 541.94, "fim": 546.24, "pausa": 0.5, "t": [541.94, 542.18, 542.52, 543.14, 543.14, 543.82, 544.06, 544.44, 544.96, 545.34, 545.78]}, {"i": 123, "texto": "Existe o contrário.", "cap": "NÍVEL 5: O FUNDO", "ini": 547.14, "fim": 548.18, "pausa": 0.44, "t": [547.14, 547.56, 547.64]}, {"i": 124, "texto": "Fotografias da Terra feitas da estação espacial e da órbita da Lua, ao longo de décadas.", "cap": "NÍVEL 5: O FUNDO", "ini": 549.08, "fim": 554.46, "pausa": 0.0, "t": [549.08, 549.76, 549.96, 550.3, 550.7, 550.9, 551.32, 551.84, 552.16, 552.26, 552.64, 552.8, 553.34, 553.54, 553.74, 553.92]}, {"i": 125, "texto": "O fundo do iceberg é o lugar com mais certeza e menos prova.", "cap": "NÍVEL 5: O FUNDO", "ini": 555.22, "fim": 559.38, "pausa": 1.34, "t": [555.22, 555.4, 555.76, 555.9, 556.22, 556.78, 556.86, 557.14, 557.36, 557.7, 558.18, 558.72, 559.02]}, {"i": 126, "texto": "Agora olhe o iceberg inteiro de novo.", "cap": "O QUE O ICEBERG ENSINA", "ini": 561.28, "fim": 563.68, "pausa": 0.0, "t": [561.28, 562.04, 562.22, 562.3, 562.68, 563.24, 563.44]}, {"i": 127, "texto": "As conspirações que se provaram verdadeiras estão no topo.", "cap": "O QUE O ICEBERG ENSINA", "ini": 564.32, "fim": 567.8, "pausa": 0.0, "t": [564.32, 564.48, 565.1, 565.28, 565.4, 565.78, 566.52, 566.86, 567.02]}, {"i": 128, "texto": "Elas não foram descobertas por quem acredita em tudo.", "cap": "O QUE O ICEBERG ENSINA", "ini": 567.94, "fim": 570.56, "pausa": 0.0, "t": [567.94, 568.2, 568.3, 568.56, 569.28, 569.52, 569.85, 570.015, 570.18]}, {"i": 129, "texto": "Foram descobertas por gente que pediu documentos, leu relatórios e comparou datas.", "cap": "O QUE O ICEBERG ENSINA", "ini": 571.1, "fim": 575.92, "pausa": 0.0, "t": [571.1, 571.32, 572.0, 572.22, 572.44, 572.62, 572.9, 573.9, 574.2, 574.84, 575.1, 575.56]}, {"i": 130, "texto": "E elas têm algo em comum.", "cap": "O QUE O ICEBERG ENSINA", "ini": 576.62, "fim": 577.7, "pausa": 0.0, "t": [576.62, 576.74, 576.9, 577.1, 577.32, 577.44]}, {"i": 131, "texto": "Quase sempre envolvem pessoas comuns, que não sabiam de nada.", "cap": "O QUE O ICEBERG ENSINA", "ini": 578.34, "fim": 582.32, "pausa": 0.26, "t": [578.34, 578.72, 579.16, 579.7, 580.04, 580.86, 581.12, 581.34, 581.8, 582.02]}, {"i": 132, "texto": "Os soldados do Vietnã.", "cap": "O QUE O ICEBERG ENSINA", "ini": 583.22, "fim": 584.4, "pausa": 0.4, "t": [583.22, 583.36, 583.74, 583.94]}, {"i": 133, "texto": "Os homens de Tuskegee.", "cap": "O QUE O ICEBERG ENSINA", "ini": 585.3, "fim": 586.44, "pausa": 0.42, "t": [585.3, 585.48, 585.74, 585.88]}, {"i": 134, "texto": "As pessoas que tomaram LSD sem saber.", "cap": "O QUE O ICEBERG ENSINA", "ini": 587.34, "fim": 589.72, "pausa": 0.0, "t": [587.34, 587.46, 587.8, 587.98, 588.38, 588.98, 589.36]}, {"i": 135, "texto": "Já as teorias do fundo têm o efeito contrário.", "cap": "O QUE O ICEBERG ENSINA", "ini": 590.42, "fim": 593.2, "pausa": 0.4, "t": [590.42, 590.72, 590.88, 591.24, 591.42, 591.84, 592.2, 592.3, 592.58]}, {"i": 136, "texto": "Elas desviam a atenção.", "cap": "O QUE O ICEBERG ENSINA", "ini": 594.1, "fim": 595.44, "pausa": 0.22, "t": [594.1, 594.22, 594.96, 595.08]}, {"i": 137, "texto": "Enquanto alguém discute se a Terra é plana, documentos de verdade continuam esperando para ser lidos.", "cap": "O QUE O ICEBERG ENSINA", "ini": 596.34, "fim": 602.04, "pausa": 0.0, "t": [596.34, 596.74, 597.0, 597.5, 597.72, 597.84, 597.96, 598.16, 598.84, 599.42, 599.52, 599.9, 600.74, 601.18, 601.52, 601.72]}, {"i": 138, "texto": "Da próxima vez que uma teoria aparecer no seu celular, faça três perguntas.", "cap": "O QUE O ICEBERG ENSINA", "ini": 602.04, "fim": 607.18, "pausa": 0.54, "t": [602.04, 602.88, 603.16, 603.56, 603.74, 603.84, 604.2, 604.7, 604.9, 605.0, 605.88, 606.12, 606.5]}, {"i": 139, "texto": "Existe um documento?", "cap": "O QUE O ICEBERG ENSINA", "ini": 608.08, "fim": 609.24, "pausa": 0.26, "t": [608.08, 608.58, 608.68]}, {"i": 140, "texto": "Quem liberou esse documento?", "cap": "O QUE O ICEBERG ENSINA", "ini": 610.14, "fim": 611.52, "pausa": 0.34, "t": [610.14, 610.28, 610.76, 610.92]}, {"i": 141, "texto": "E dá para ler o original, ou só o resumo de alguém?", "cap": "O QUE O ICEBERG ENSINA", "ini": 612.42, "fim": 615.34, "pausa": 0.0, "t": [612.42, 612.56, 612.9, 613.08, 613.28, 613.4, 613.8, 614.32, 614.58, 614.68, 615.02, 615.14]}, {"i": 142, "texto": "As conspirações do topo passam nesse teste.", "cap": "O QUE O ICEBERG ENSINA", "ini": 616.12, "fim": 618.7, "pausa": 0.38, "t": [616.12, 616.28, 616.9, 617.08, 617.62, 618.1, 618.32]}, {"i": 143, "texto": "As do fundo, não.", "cap": "O QUE O ICEBERG ENSINA", "ini": 619.6, "fim": 620.84, "pausa": 0.32, "t": [619.6, 619.74, 619.86, 620.7]}, {"i": 144, "texto": "A pergunta certa não é em que acreditar.", "cap": "O QUE O ICEBERG ENSINA", "ini": 621.74, "fim": 624.32, "pausa": 0.0, "t": [621.74, 621.92, 622.2, 622.78, 623.02, 623.28, 623.48, 623.72]}, {"i": 145, "texto": "É o que dá para provar.", "cap": "O QUE O ICEBERG ENSINA", "ini": 624.8, "fim": 626.16, "pausa": 1.32, "t": [624.8, 624.92, 625.0, 625.16, 625.44, 625.64]}, {"i": 146, "texto": "No topo, governos que confessaram.", "cap": "FECHO", "ini": 628.06, "fim": 630.36, "pausa": 0.0, "t": [628.06, 628.26, 629.12, 629.58, 629.68]}, {"i": 147, "texto": "No meio, segredos verdadeiros que viraram lenda.", "cap": "FECHO", "ini": 630.88, "fim": 633.98, "pausa": 0.0, "t": [630.88, 631.06, 631.82, 632.34, 633.06, 633.26, 633.6]}, {"i": 148, "texto": "No fundo, muita certeza e nenhum papel.", "cap": "FECHO", "ini": 633.98, "fim": 637.8, "pausa": 0.0, "t": [633.98, 634.72, 635.56, 636.0, 636.56, 637.12, 637.4]}, {"i": 149, "texto": "Até onde vai a verdade?", "cap": "FECHO", "ini": 638.52, "fim": 639.74, "pausa": 0.0, "t": [638.52, 638.82, 639.1, 639.34, 639.44]}, {"i": 150, "texto": "Até onde vão os documentos.", "cap": "FECHO", "ini": 640.54, "fim": 642.22, "pausa": 0.0, "t": [640.54, 640.84, 641.16, 641.48, 641.58]}]}